# Frontend (safe to expose in the browser bundle — must start with VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY=

# Server-only secrets. NEVER prefix these with VITE_ — that would bundle them
# into the client JS. These are read by Supabase Edge Functions / server code
# only, and must be set as Supabase project secrets (Dashboard > Edge Functions
# > Secrets, or `supabase secrets set`), not committed here.
# SPORTS_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Sports data provider for the sync-sports-data Edge Function. Defaults to
# "mock" if unset. Set to "the_odds_api" (and provide SPORTS_API_KEY above)
# once you have a real key from https://the-odds-api.com.
# SPORTS_PROVIDER=mock
